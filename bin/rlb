#!/usr/bin/env bash
# ==============================================================================
# RobloxLinuxBlocker (rlb)
# Complete blocking of ALL Roblox IP addresses and domains on Linux (including Sober).
# 
# License: GNU Affero General Public License v3.0 (AGPL-3.0)
# ==============================================================================

set -e

# --- Colors and Formatting ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# --- Paths and Constants ---
APP_NAME="RobloxLinuxBlocker"
VERSION="1.1.0"
SYSTEMD_SERVICE="rlb.service"
BOT_SERVICE="rlb-bot.service"

HOSTS_MARKER_START="# --- ROBLOX-LINUX-BLOCKER-START ---"
HOSTS_MARKER_END="# --- ROBLOX-LINUX-BLOCKER-END ---"
IPTABLES_CHAIN="RLB_BLOCK"

# Locate configuration data files
REAL_SCRIPT_PATH="$(readlink -f "$0")"
SCRIPT_DIR="$(dirname "$REAL_SCRIPT_PATH")"

if [[ -f "/etc/rlb/roblox_ips.txt" ]]; then
    IP_FILE="/etc/rlb/roblox_ips.txt"
    DOMAIN_FILE="/etc/rlb/roblox_domains.txt"
    CONFIG_FILE="/etc/rlb/bot_config.json"
elif [[ -f "${SCRIPT_DIR}/../data/roblox_ips.txt" ]]; then
    IP_FILE="${SCRIPT_DIR}/../data/roblox_ips.txt"
    DOMAIN_FILE="${SCRIPT_DIR}/../data/roblox_domains.txt"
    CONFIG_FILE="${SCRIPT_DIR}/../data/bot_config.json"
elif [[ -f "${SCRIPT_DIR}/data/roblox_ips.txt" ]]; then
    IP_FILE="${SCRIPT_DIR}/data/roblox_ips.txt"
    DOMAIN_FILE="${SCRIPT_DIR}/data/roblox_domains.txt"
    CONFIG_FILE="${SCRIPT_DIR}/data/bot_config.json"
else
    IP_FILE="/etc/rlb/roblox_ips.txt"
    DOMAIN_FILE="/etc/rlb/roblox_domains.txt"
    CONFIG_FILE="/etc/rlb/bot_config.json"
fi

# --- Helper Functions ---

check_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${YELLOW}[!] Root privileges required. Re-running with sudo...${NC}"
        exec sudo bash "$0" "$@"
    fi
}

log_info() {
    echo -e "${CYAN}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[OK]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

get_subnets() {
    if [[ ! -f "$IP_FILE" ]]; then
        log_error "IP list file not found: $IP_FILE"
        return 1
    fi
    grep -E '^[0-9a-fA-F:.]+' "$IP_FILE" | awk '{print $1}'
}

get_domains() {
    if [[ ! -f "$DOMAIN_FILE" ]]; then
        log_error "Domain list file not found: $DOMAIN_FILE"
        return 1
    fi
    grep -E '^[a-zA-Z0-9.-]+' "$DOMAIN_FILE" | awk '{print $1}'
}

# --- Blocking Logic ---

block_routes() {
    log_info "Applying Linux kernel blackhole FIB routes..."
    local count=0
    while IFS= read -r subnet; do
        [[ -z "$subnet" ]] && continue
        if [[ "$subnet" =~ : ]]; then
            # IPv6
            if ip -6 route show | grep -q "$subnet"; then
                :
            else
                ip -6 route add blackhole "$subnet" 2>/dev/null || true
            fi
        else
            # IPv4
            if ip route show | grep -q "$subnet"; then
                :
            else
                ip route add blackhole "$subnet" 2>/dev/null || true
            fi
        fi
        ((count++))
    done < <(get_subnets)
    log_success "Blackhole routing configured for $count subnets."
}

unblock_routes() {
    log_info "Removing Linux kernel blackhole FIB routes..."
    local count=0
    while IFS= read -r subnet; do
        [[ -z "$subnet" ]] && continue
        if [[ "$subnet" =~ : ]]; then
            ip -6 route del blackhole "$subnet" 2>/dev/null || true
        else
            ip route del blackhole "$subnet" 2>/dev/null || true
        fi
        ((count++))
    done < <(get_subnets)
    log_success "Blackhole routes cleared."
}

block_iptables() {
    log_info "Configuring iptables / ip6tables firewall rules..."

    # IPv4 iptables
    if command -v iptables &>/dev/null; then
        iptables -N "$IPTABLES_CHAIN" 2>/dev/null || iptables -F "$IPTABLES_CHAIN"
        
        # Ensure rules exist in OUTPUT and FORWARD
        iptables -C OUTPUT -j "$IPTABLES_CHAIN" 2>/dev/null || iptables -I OUTPUT 1 -j "$IPTABLES_CHAIN"
        iptables -C FORWARD -j "$IPTABLES_CHAIN" 2>/dev/null || iptables -I FORWARD 1 -j "$IPTABLES_CHAIN"

        while IFS= read -r subnet; do
            [[ -z "$subnet" ]] && continue
            if [[ ! "$subnet" =~ : ]]; then
                iptables -A "$IPTABLES_CHAIN" -d "$subnet" -j REJECT --reject-with icmp-port-unreachable 2>/dev/null || \
                iptables -A "$IPTABLES_CHAIN" -d "$subnet" -j DROP 2>/dev/null || true
            fi
        done < <(get_subnets)
        log_success "IPv4 iptables chain '$IPTABLES_CHAIN' activated."
    fi

    # IPv6 ip6tables
    if command -v ip6tables &>/dev/null; then
        ip6tables -N "$IPTABLES_CHAIN" 2>/dev/null || ip6tables -F "$IPTABLES_CHAIN"

        ip6tables -C OUTPUT -j "$IPTABLES_CHAIN" 2>/dev/null || ip6tables -I OUTPUT 1 -j "$IPTABLES_CHAIN"
        ip6tables -C FORWARD -j "$IPTABLES_CHAIN" 2>/dev/null || ip6tables -I FORWARD 1 -j "$IPTABLES_CHAIN"

        while IFS= read -r subnet; do
            [[ -z "$subnet" ]] && continue
            if [[ "$subnet" =~ : ]]; then
                ip6tables -A "$IPTABLES_CHAIN" -d "$subnet" -j REJECT 2>/dev/null || \
                ip6tables -A "$IPTABLES_CHAIN" -d "$subnet" -j DROP 2>/dev/null || true
            fi
        done < <(get_subnets)
        log_success "IPv6 ip6tables chain '$IPTABLES_CHAIN' activated."
    fi
}

unblock_iptables() {
    log_info "Removing iptables / ip6tables firewall rules..."

    if command -v iptables &>/dev/null; then
        iptables -D OUTPUT -j "$IPTABLES_CHAIN" 2>/dev/null || true
        iptables -D FORWARD -j "$IPTABLES_CHAIN" 2>/dev/null || true
        iptables -F "$IPTABLES_CHAIN" 2>/dev/null || true
        iptables -X "$IPTABLES_CHAIN" 2>/dev/null || true
    fi

    if command -v ip6tables &>/dev/null; then
        ip6tables -D OUTPUT -j "$IPTABLES_CHAIN" 2>/dev/null || true
        ip6tables -D FORWARD -j "$IPTABLES_CHAIN" 2>/dev/null || true
        ip6tables -F "$IPTABLES_CHAIN" 2>/dev/null || true
        ip6tables -X "$IPTABLES_CHAIN" 2>/dev/null || true
    fi

    log_success "Firewall rules cleared."
}

block_hosts() {
    log_info "Blocking Roblox domains in /etc/hosts..."
    unblock_hosts_silent

    {
        echo "$HOSTS_MARKER_START"
        while IFS= read -r domain; do
            [[ -z "$domain" ]] && continue
            echo "0.0.0.0 $domain"
            echo "::1 $domain"
        done < <(get_domains)
        echo "$HOSTS_MARKER_END"
    } >> /etc/hosts

    log_success "Roblox domains blocked in /etc/hosts."
}

unblock_hosts_silent() {
    if grep -q "$HOSTS_MARKER_START" /etc/hosts 2>/dev/null; then
        sed -i "/$HOSTS_MARKER_START/,/$HOSTS_MARKER_END/d" /etc/hosts
    fi
}

unblock_hosts() {
    log_info "Removing Roblox entries from /etc/hosts..."
    unblock_hosts_silent
    log_success "/etc/hosts cleared."
}

terminate_sober_processes() {
    log_info "Checking for active Sober / Roblox processes..."
    local killed=0
    for proc in sober sober.bin Vinegar "org.vinegarhq.Sober"; do
        if pgrep -fi "$proc" &>/dev/null; then
            pkill -9 -fi "$proc" 2>/dev/null || true
            killed=1
        fi
    done
    if [[ $killed -eq 1 ]]; then
        log_warn "Active Sober / Roblox sessions were forcibly terminated!"
    fi
}

# --- Main Actions ---

do_on() {
    echo -e "${BOLD}${CYAN}=== Enabling Roblox Block (IP, DNS, Sober) ===${NC}"
    terminate_sober_processes
    block_routes
    block_iptables
    block_hosts
    echo -e "${GREEN}${BOLD}✔ Roblox is COMPLETELY BLOCKED! (Sober & native connections dropped)${NC}\n"
}

do_off() {
    echo -e "${BOLD}${YELLOW}=== Disabling Roblox Block ===${NC}"
    unblock_routes
    unblock_iptables
    unblock_hosts

    # Disable systemd service if active
    if command -v systemctl &>/dev/null; then
        if systemctl is-enabled "$SYSTEMD_SERVICE" &>/dev/null; then
            log_info "Disabling autostart service $SYSTEMD_SERVICE..."
            systemctl disable "$SYSTEMD_SERVICE" 2>/dev/null || true
        fi
        if systemctl is-active "$SYSTEMD_SERVICE" &>/dev/null; then
            systemctl stop "$SYSTEMD_SERVICE" 2>/dev/null || true
        fi
    fi

    echo -e "${GREEN}${BOLD}✔ Roblox blocking disabled successfully.${NC}\n"
}

do_auto() {
    echo -e "${BOLD}${CYAN}=== Setting up RobloxLinuxBlocker Autostart ===${NC}"
    
    # 1. Apply blocking immediately
    do_on

    # 2. Check and configure systemd service
    if ! command -v systemctl &>/dev/null; then
        log_error "systemd (systemctl) not found on this system."
        exit 1
    fi

    local svc_file="/etc/systemd/system/${SYSTEMD_SERVICE}"
    if [[ ! -f "$svc_file" ]]; then
        log_info "Creating systemd service $svc_file..."
        local src_svc="${SCRIPT_DIR}/../systemd/${SYSTEMD_SERVICE}"
        if [[ -f "$src_svc" ]]; then
            cp "$src_svc" "$svc_file"
        elif [[ -f "${SCRIPT_DIR}/systemd/${SYSTEMD_SERVICE}" ]]; then
            cp "${SCRIPT_DIR}/systemd/${SYSTEMD_SERVICE}" "$svc_file"
        else
            cat <<EOF > "$svc_file"
[Unit]
Description=Roblox Linux Blocker (RLB)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/rlb on
ExecStop=/usr/local/bin/rlb off

[Install]
WantedBy=multi-user.target
EOF
        fi
        chmod 644 "$svc_file"
    fi

    systemctl daemon-reload
    systemctl enable "$SYSTEMD_SERVICE"
    log_success "Autostart enabled! Service $SYSTEMD_SERVICE will activate automatically on boot."
    echo -e "${GREEN}${BOLD}✔ Autostart configured: 'rlb auto' completed successfully.${NC}\n"
}

do_noauto() {
    echo -e "${BOLD}${YELLOW}=== Disabling RobloxLinuxBlocker Autostart ===${NC}"
    if command -v systemctl &>/dev/null; then
        systemctl disable "$SYSTEMD_SERVICE" 2>/dev/null || true
        log_success "Autostart service $SYSTEMD_SERVICE disabled (current block remains active)."
    else
        log_error "systemctl not found."
    fi
}

do_status() {
    echo -e "${BOLD}${CYAN}=== RobloxLinuxBlocker (RLB) Status ===${NC}"

    # 1. Check systemd autostart
    echo -n "Autostart (systemd): "
    if command -v systemctl &>/dev/null; then
        if systemctl is-enabled "$SYSTEMD_SERVICE" &>/dev/null; then
            echo -e "${GREEN}ENABLED${NC}"
        else
            echo -e "${YELLOW}DISABLED${NC}"
        fi
    else
        echo -e "${RED}systemd not available${NC}"
    fi

    # 2. Check blackhole routes
    local blackhole_v4_count
    blackhole_v4_count=$(ip route show 2>/dev/null | grep -c "blackhole" || true)
    local blackhole_v6_count
    blackhole_v6_count=$(ip -6 route show 2>/dev/null | grep -c "blackhole" || true)
    echo -n "Kernel Routes (Blackhole FIB): "
    if [[ "$blackhole_v4_count" -gt 0 || "$blackhole_v6_count" -gt 0 ]]; then
        echo -e "${GREEN}ACTIVE ($blackhole_v4_count IPv4, $blackhole_v6_count IPv6)${NC}"
    else
        echo -e "${RED}INACTIVE${NC}"
    fi

    # 3. Check iptables
    echo -n "Firewall (iptables): "
    if iptables -L "$IPTABLES_CHAIN" -n &>/dev/null; then
        local rule_count
        rule_count=$(iptables -L "$IPTABLES_CHAIN" -n 2>/dev/null | grep -c -E "REJECT|DROP" || true)
        echo -e "${GREEN}ACTIVE ($rule_count blocking rules)${NC}"
    else
        echo -e "${RED}INACTIVE${NC}"
    fi

    # 4. Check /etc/hosts
    echo -n "DNS Blocking (/etc/hosts): "
    if grep -q "$HOSTS_MARKER_START" /etc/hosts 2>/dev/null; then
        local hosts_count
        hosts_count=$(sed -n "/$HOSTS_MARKER_START/,/$HOSTS_MARKER_END/p" /etc/hosts | grep -c "0.0.0.0" || true)
        echo -e "${GREEN}ACTIVE ($hosts_count domains blocked)${NC}"
    else
        echo -e "${RED}INACTIVE${NC}"
    fi

    # 5. Check Sober processes
    echo -n "Sober / Roblox Client: "
    if pgrep -fi "sober" &>/dev/null; then
        echo -e "${YELLOW}RUNNING (will be terminated on 'rlb on')${NC}"
    else
        echo -e "${GREEN}Not running${NC}"
    fi

    # 6. Check Telegram Bot
    echo -n "Telegram Bot Service: "
    if command -v systemctl &>/dev/null && systemctl is-active "$BOT_SERVICE" &>/dev/null; then
        echo -e "${GREEN}RUNNING (systemd)${NC}"
    elif pgrep -f "rlb-telegram-bot" &>/dev/null; then
        echo -e "${GREEN}RUNNING (background process)${NC}"
    else
        echo -e "${YELLOW}STOPPED${NC}"
    fi

    echo ""
}

do_update() {
    echo -e "${BOLD}${CYAN}=== Updating Roblox IP Prefix Ranges from RIPEstat/ARIN ===${NC}"
    log_info "Fetching announced prefixes for AS22697 (Roblox)..."

    local temp_json
    temp_json=$(mktemp)

    if curl -s --connect-timeout 10 "https://stat.ripe.net/data/announced-prefixes/data.json?resource=AS22697" -o "$temp_json"; then
        local temp_ips
        temp_ips=$(mktemp)

        python3 -c "
import json, ipaddress, sys

prefixes = set()

# Base Roblox blocks
base_blocks = [
    '128.116.0.0/16',
    '107.180.192.0/20',
    '209.206.40.0/21',
    '205.201.62.0/23',
    '103.140.28.0/23',
    '141.193.3.0/24',
    '208.185.116.0/24',
    '208.185.166.0/24',
    '208.185.173.0/24',
    '216.200.230.0/24',
    '23.173.192.0/24',
    '64.125.149.0/24',
    '2620:135:6000::/40',
    '2620:2b:e000::/48'
]
prefixes.update(base_blocks)

try:
    with open('$temp_json') as f:
        data = json.load(f)
        for p in data.get('data', {}).get('prefixes', []):
            prefixes.add(p['prefix'])
except Exception:
    pass

v4, v6 = [], []
for p in prefixes:
    try:
        net = ipaddress.ip_network(p, strict=False)
        if net.version == 4:
            v4.append(net)
        else:
            v6.append(net)
    except Exception:
        pass

v4_opt = sorted(list(ipaddress.collapse_addresses(v4)))
v6_opt = sorted(list(ipaddress.collapse_addresses(v6)))

print('# Roblox Corporation (AS22697) IP Prefixes')
print('# Updated dynamically via rlb update')
print('\n# IPv4')
for n in v4_opt:
    print(n)
print('\n# IPv6')
for n in v6_opt:
    print(n)
" > "$temp_ips"

        if [[ -s "$temp_ips" ]]; then
            cp "$temp_ips" "$IP_FILE"
            log_success "IP prefix list updated successfully: $IP_FILE"
            rm -f "$temp_json" "$temp_ips"

            # If blocking is currently active, refresh rules
            if iptables -L "$IPTABLES_CHAIN" -n &>/dev/null; then
                log_info "Refreshing active blocking rules..."
                do_on
            fi
        else
            log_error "Failed to generate valid prefix data."
            rm -f "$temp_json" "$temp_ips"
            return 1
        fi
    else
        log_error "Connection failed while querying RIPEstat API."
        rm -f "$temp_json"
        return 1
    fi
}

do_test() {
    echo -e "${BOLD}${CYAN}=== Testing Roblox Blocking Status ===${NC}"
    local blocked=1

    echo -n "1. Checking domain roblox.com (DNS & HTTP): "
    if curl -s --connect-timeout 2 -m 3 http://roblox.com &>/dev/null || curl -s --connect-timeout 2 -m 3 https://roblox.com &>/dev/null; then
        echo -e "${RED}PASSING (NOT blocked!)${NC}"
        blocked=0
    else
        echo -e "${GREEN}BLOCKED ✔${NC}"
    fi

    echo -n "2. Checking API endpoint api.roblox.com: "
    if curl -s --connect-timeout 2 -m 3 https://api.roblox.com &>/dev/null; then
        echo -e "${RED}PASSING (NOT blocked!)${NC}"
        blocked=0
    else
        echo -e "${GREEN}BLOCKED ✔${NC}"
    fi

    echo -n "3. Checking direct ping to Roblox game server pool (128.116.116.1): "
    if ping -c 1 -W 1 128.116.116.1 &>/dev/null; then
        echo -e "${RED}PASSING (NOT blocked!)${NC}"
        blocked=0
    else
        echo -e "${GREEN}BLOCKED ✔${NC}"
    fi

    echo ""
    if [[ $blocked -eq 1 ]]; then
        echo -e "${GREEN}${BOLD}All clear! Roblox and Sober are reliably blocked on this machine.${NC}"
    else
        echo -e "${YELLOW}${BOLD}Warning: Some requests are getting through. Ensure you ran 'sudo rlb on' or 'sudo rlb auto'.${NC}"
    fi
    echo ""
}

# --- Telegram Bot Management ---

do_add_token() {
    local token="$1"
    if [[ -z "$token" ]]; then
        log_error "Usage: rlb add token <BOT_TOKEN>"
        exit 1
    fi
    mkdir -p "$(dirname "$CONFIG_FILE")"
    python3 -c "
import json, os
cfg = '$CONFIG_FILE'
data = {'bot_token': '', 'parents': []}
if os.path.exists(cfg):
    try:
        with open(cfg, 'r') as f:
            data = json.load(f)
    except Exception:
        pass
data['bot_token'] = '$token'
with open(cfg, 'w') as f:
    json.dump(data, f, indent=2)
os.chmod(cfg, 0o600)
"
    log_success "Telegram bot token saved successfully in $CONFIG_FILE"

    if command -v systemctl &>/dev/null && systemctl is-active "$BOT_SERVICE" &>/dev/null; then
        systemctl restart "$BOT_SERVICE"
        log_info "Restarted $BOT_SERVICE to apply the new bot token."
    fi
}

do_add_parent() {
    local parent_id="$1"
    if [[ -z "$parent_id" ]]; then
        log_error "Usage: rlb add parent <TELEGRAM_USER_ID>"
        exit 1
    fi
    if [[ ! "$parent_id" =~ ^[0-9]+$ ]]; then
        log_error "Parent ID must be a numeric Telegram ID."
        exit 1
    fi
    mkdir -p "$(dirname "$CONFIG_FILE")"
    python3 -c "
import json, os
cfg = '$CONFIG_FILE'
data = {'bot_token': '', 'parents': []}
if os.path.exists(cfg):
    try:
        with open(cfg, 'r') as f:
            data = json.load(f)
    except Exception:
        pass
parents = set(data.get('parents', []))
parents.add(int('$parent_id'))
data['parents'] = sorted(list(parents))
with open(cfg, 'w') as f:
    json.dump(data, f, indent=2)
os.chmod(cfg, 0o600)
"
    log_success "Added parent Telegram ID: $parent_id"
}

do_remove_parent() {
    local parent_id="$1"
    if [[ -z "$parent_id" ]]; then
        log_error "Usage: rlb remove parent <TELEGRAM_USER_ID>"
        exit 1
    fi
    mkdir -p "$(dirname "$CONFIG_FILE")"
    python3 -c "
import json, os
cfg = '$CONFIG_FILE'
if not os.path.exists(cfg):
    exit(0)
try:
    with open(cfg, 'r') as f:
        data = json.load(f)
except Exception:
    exit(0)
parents = [p for p in data.get('parents', []) if str(p) != '$parent_id']
data['parents'] = parents
with open(cfg, 'w') as f:
    json.dump(data, f, indent=2)
os.chmod(cfg, 0o600)
"
    log_success "Removed parent Telegram ID: $parent_id"
}

do_list_parents() {
    python3 -c "
import json, os
cfg = '$CONFIG_FILE'
if not os.path.exists(cfg):
    print('No parents registered yet.')
    exit(0)
try:
    with open(cfg, 'r') as f:
        data = json.load(f)
    parents = data.get('parents', [])
    if parents:
        print('Registered parent Telegram IDs:')
        for p in parents:
            print(f'  • {p}')
    else:
        print('No parents registered yet.')
except Exception as e:
    print(f'Error reading config: {e}')
"
}

do_bot() {
    local action="${1:-status}"
    case "$action" in
        start)
            if command -v systemctl &>/dev/null; then
                systemctl daemon-reload 2>/dev/null || true
                systemctl enable --now "$BOT_SERVICE"
                log_success "$BOT_SERVICE started and enabled."
            else
                log_info "Starting rlb-telegram-bot in background..."
                nohup /usr/local/bin/rlb-telegram-bot >/tmp/rlb-bot.log 2>&1 &
                log_success "rlb-telegram-bot started in background."
            fi
            ;;
        stop)
            if command -v systemctl &>/dev/null; then
                systemctl stop "$BOT_SERVICE" 2>/dev/null || true
                systemctl disable "$BOT_SERVICE" 2>/dev/null || true
            fi
            pkill -f "rlb-telegram-bot" 2>/dev/null || true
            log_success "Telegram bot service stopped."
            ;;
        restart)
            if command -v systemctl &>/dev/null; then
                systemctl restart "$BOT_SERVICE"
                log_success "$BOT_SERVICE restarted."
            else
                pkill -f "rlb-telegram-bot" 2>/dev/null || true
                nohup /usr/local/bin/rlb-telegram-bot >/tmp/rlb-bot.log 2>&1 &
                log_success "rlb-telegram-bot restarted in background."
            fi
            ;;
        status)
            if command -v systemctl &>/dev/null; then
                systemctl status "$BOT_SERVICE" --no-pager || true
            else
                if pgrep -f "rlb-telegram-bot" &>/dev/null; then
                    log_success "rlb-telegram-bot is running."
                else
                    log_warn "rlb-telegram-bot is not running."
                fi
            fi
            ;;
        *)
            log_error "Unknown bot command: $action (valid: start, stop, restart, status)"
            exit 1
            ;;
    esac
}

show_help() {
    echo -e "${BOLD}${CYAN}${APP_NAME} v${VERSION}${NC}"
    echo -e "Universal Roblox IP and domain blocker for Linux (including Sober & Flatpak).\n"
    echo -e "${BOLD}System Controls:${NC}"
    echo -e "  rlb ${GREEN}auto${NC}                     - Enable blocking and configure autostart via systemd"
    echo -e "  rlb ${RED}off${NC}                      - Completely disable Roblox blocking and autostart"
    echo -e "  rlb ${GREEN}on${NC}                       - Enable blocking immediately (current session)"
    echo -e "  rlb ${YELLOW}noauto${NC}                   - Disable systemd autostart (keep current block active)"
    echo -e "  rlb ${BLUE}status${NC}                   - Show status of firewall rules, routes, hosts, and bot"
    echo -e "  rlb ${CYAN}update${NC}                   - Fetch latest Roblox IP prefixes from public registries"
    echo -e "  rlb ${BOLD}test${NC}                     - Verify that Roblox and Sober traffic is blocked"
    echo ""
    echo -e "${BOLD}Telegram Bot & Parental Controls:${NC}"
    echo -e "  rlb ${GREEN}add token${NC} <TOKEN>        - Save Telegram bot token"
    echo -e "  rlb ${GREEN}add parent${NC} <TG_ID>       - Authorize parent Telegram user ID"
    echo -e "  rlb ${RED}remove parent${NC} <TG_ID>    - Revoke parent authorization"
    echo -e "  rlb ${BLUE}list parents${NC}             - View authorized parent Telegram IDs"
    echo -e "  rlb ${CYAN}bot start|stop|status${NC}    - Control Telegram bot background service"
    echo -e "  rlb ${YELLOW}help${NC}                     - Display this help message"
    echo ""
    echo -e "${BOLD}Examples:${NC}"
    echo -e "  sudo rlb add token 123456789:ABCdefGHIjkLMNopQRstUVwxyz"
    echo -e "  sudo rlb add parent 987654321"
    echo -e "  sudo rlb bot start"
    echo -e "  sudo rlb auto"
    echo ""
}

# --- Main Command Dispatcher ---

COMMAND="${1:-}"

case "$COMMAND" in
    auto)
        check_root "$@"
        do_auto
        ;;
    off|unblock|stop|disable)
        check_root "$@"
        do_off
        ;;
    on|block|start|enable)
        check_root "$@"
        do_on
        ;;
    noauto)
        check_root "$@"
        do_noauto
        ;;
    status)
        do_status
        ;;
    update)
        check_root "$@"
        do_update
        ;;
    test)
        do_test
        ;;
    add)
        check_root "$@"
        SUBCMD="${2:-}"
        case "$SUBCMD" in
            parent)
                do_add_parent "${3:-}"
                ;;
            token)
                do_add_token "${3:-}"
                ;;
            *)
                log_error "Unknown add command: $SUBCMD (valid: rlb add parent <ID> | rlb add token <TOKEN>)"
                exit 1
                ;;
        esac
        ;;
    remove)
        check_root "$@"
        SUBCMD="${2:-}"
        case "$SUBCMD" in
            parent)
                do_remove_parent "${3:-}"
                ;;
            *)
                log_error "Unknown remove command: $SUBCMD (valid: rlb remove parent <ID>)"
                exit 1
                ;;
        esac
        ;;
    list)
        SUBCMD="${2:-}"
        case "$SUBCMD" in
            parents|parent)
                do_list_parents
                ;;
            *)
                log_error "Unknown list command: $SUBCMD (valid: rlb list parents)"
                exit 1
                ;;
        esac
        ;;
    bot)
        check_root "$@"
        do_bot "${2:-status}"
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        echo -e "${RED}Unknown command: $COMMAND${NC}\n"
        show_help
        exit 1
        ;;
esac
