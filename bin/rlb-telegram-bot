# Config and stats path resolution
CONFIG_PATHS = [
    "/etc/rlb/bot_config.json",
    os.path.join(os.path.dirname(os.path.abspath(__file__)), "../data/bot_config.json"),
    os.path.join(os.path.dirname(os.path.abspath(__file__)), "data/bot_config.json"),
]

STATS_PATHS = [
    "/etc/rlb/stats.json",
    os.path.join(os.path.dirname(os.path.abspath(__file__)), "../data/stats.json"),
    os.path.join(os.path.dirname(os.path.abspath(__file__)), "data/stats.json"),
]

PIN_PATHS = [
    "/etc/rlb/.pin",
    os.path.join(os.path.dirname(os.path.abspath(__file__)), "../data/.pin"),
    os.path.join(os.path.dirname(os.path.abspath(__file__)), "data/.pin"),
]

RLB_BIN = "/usr/local/bin/rlb"
if not os.path.exists(RLB_BIN):
    RLB_BIN = os.path.join(os.path.dirname(os.path.abspath(__file__)), "rlb")

running = True
timer_thread = None
timer_end_time = 0
timer_chat_id = None
timer_lock = threading.Lock()

last_alert_time = 0
last_packet_count = 0


