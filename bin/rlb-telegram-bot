def get_config_file():
    for p in CONFIG_PATHS:
        if os.path.exists(p):
            return p
    return CONFIG_PATHS[0]


def get_stats_file():
    for p in STATS_PATHS:
        if os.path.exists(p):
            return p
    return STATS_PATHS[0]


def has_pin_configured():
    for p in PIN_PATHS:
        if os.path.exists(p) and os.path.getsize(p) > 0:
            return True
    return False


def load_config():
    config_file = get_config_file()
    if not os.path.exists(config_file):
        return {"bot_token": "", "parents": [], "user_languages": {}}
    try:
        with open(config_file, "r", encoding="utf-8") as f:
            data = json.load(f)
            if "user_languages" not in data:
                data["user_languages"] = {}
            return data
    except Exception as e:
        print(f"[!] Error loading config: {e}", file=sys.stderr)
        return {"bot_token": "", "parents": [], "user_languages": {}}


def save_config(config_data):
    config_file = get_config_file()
    os.makedirs(os.path.dirname(config_file), exist_ok=True)
    try:
        with open(config_file, "w", encoding="utf-8") as f:
            json.dump(config_data, f, indent=2)
        os.chmod(config_file, 0o600)
    except Exception as e:
        print(f"[!] Error saving config: {e}", file=sys.stderr)


def get_user_lang(user_id, config):
    user_langs = config.get("user_languages", {})
    return user_langs.get(str(user_id))


def set_user_lang(user_id, lang_code, config):
    if "user_languages" not in config:
        config["user_languages"] = {}
    config["user_languages"][str(user_id)] = lang_code
    save_config(config)


def t(lang, key, **kwargs):
    l = lang if lang in STRINGS else "uk"
    template = STRINGS[l].get(key, STRINGS["en"].get(key, ""))
    if kwargs:
        return template.format(**kwargs)
    return template


def load_stats():
    stats_file = get_stats_file()
    if not os.path.exists(stats_file):
        return {"attempts": 0, "last_attempt": "Never"}
    try:
        with open(stats_file, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {"attempts": 0, "last_attempt": "Never"}


def save_stats(stats_data):
    stats_file = get_stats_file()
    os.makedirs(os.path.dirname(stats_file), exist_ok=True)
    try:
        with open(stats_file, "w", encoding="utf-8") as f:
            json.dump(stats_data, f, indent=2)
    except Exception as e:
        print(f"[!] Error saving stats: {e}", file=sys.stderr)


def tg_api_request(token, method, data=None):
    url = f"https://api.telegram.org/bot{token}/{method}"
    headers = {"Content-Type": "application/json"}
    body = json.dumps(data).encode("utf-8") if data else None

    req = urllib.request.Request(url, data=body, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=35) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        err_msg = e.read().decode("utf-8")
        print(f"[!] Telegram HTTP Error ({method}): {err_msg}", file=sys.stderr)
        return None
    except Exception as e:
        print(f"[!] Telegram API error ({method}): {e}", file=sys.stderr)
        return None


def send_message(token, chat_id, text, reply_markup=None):
    payload = {
        "chat_id": chat_id,
        "text": text,
        "parse_mode": "HTML"
    }
    if reply_markup:
        payload["reply_markup"] = reply_markup
    return tg_api_request(token, "sendMessage", payload)


def broadcast_parents(token, config, text_getter):
    parents = config.get("parents", [])
    for p in parents:
        lang = get_user_lang(p, config) or "uk"
        text = text_getter(lang)
        send_message(token, p, text)


def get_language_keyboard():
    return {
        "keyboard": [
            [{"text": "🇺🇦 Українська"}, {"text": "🇬🇧 English"}]
        ],
        "resize_keyboard": True
    }


def get_settings_keyboard(lang):
    return {
        "keyboard": [
            [{"text": t(lang, "btn_lang")}],
            [{"text": t(lang, "btn_back")}]
        ],
        "resize_keyboard": True
    }


def get_main_keyboard(lang):
    return {
        "keyboard": [
            [{"text": t(lang, "btn_block")}, {"text": t(lang, "btn_unblock")}],
            [{"text": t(lang, "btn_allow_30")}, {"text": t(lang, "btn_allow_60")}],
            [{"text": t(lang, "btn_stats")}, {"text": t(lang, "btn_settings")}],
            [{"text": t(lang, "btn_help")}]
        ],
        "resize_keyboard": True
    }


def clean_terminal_output(text):
    if not text:
        return ""
    clean = re.sub(r'\x1b\[[0-9;]*[a-zA-Z]', '', text)
    clean = clean.replace('\r', '').strip()
    return html.escape(clean)


def run_rlb_cmd(cmd_arg, bypass_pin=True):
    try:
        cmd = [RLB_BIN, cmd_arg] if os.path.exists(RLB_BIN) else ["rlb", cmd_arg]
        if bypass_pin and cmd_arg in ["off", "noauto"]:
            cmd.append("--bypass-pin")
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=30)
        return res.returncode == 0, res.stdout + res.stderr
    except Exception as e:
        return False, str(e)


def get_current_packet_count():
    try:
        res = subprocess.run(["iptables", "-L", "RLB_BLOCK", "-v", "-n", "-x"],
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
        if res.returncode != 0:
            return 0
        total = 0
        for line in res.stdout.splitlines():
            parts = line.split()
            if len(parts) >= 3 and parts[2] in ["REJECT", "DROP"]:
                try:
                    total += int(parts[0])
                except ValueError:
                    pass
        return total
    except Exception:
        return 0


def cancel_active_timer():
    global timer_end_time, timer_chat_id
    with timer_lock:
        timer_end_time = 0
        timer_chat_id = None


def schedule_auto_block(token, chat_id, minutes, lang):
    global timer_end_time, timer_chat_id, timer_thread

    with timer_lock:
        timer_chat_id = chat_id
        timer_end_time = time.time() + (minutes * 60)

    def worker():
        target_time = timer_end_time
        while running and time.time() < target_time:
            with timer_lock:
                if timer_end_time == 0:
                    return
            time.sleep(1)

        with timer_lock:
            if timer_end_time == 0 or not running:
                return

        success, _ = run_rlb_cmd("on")
        with timer_lock:
            target_chat = timer_chat_id
            timer_end_time = 0
            timer_chat_id = None

        if target_chat and success:
            send_message(
                token,
                target_chat,
                t(lang, "time_up"),
                get_main_keyboard(lang)
            )

    timer_thread = threading.Thread(target=worker, daemon=True)
    timer_thread.start()


def monitor_connection_attempts(token, config):
    global last_packet_count, last_alert_time

    last_packet_count = get_current_packet_count()

    while running:
        time.sleep(15)
        current_count = get_current_packet_count()

        if current_count > last_packet_count and last_packet_count > 0:
            diff = current_count - last_packet_count
            last_packet_count = current_count

            now_str = time.strftime("%Y-%m-%d %H:%M:%S")
            stats = load_stats()
            stats["attempts"] = stats.get("attempts", 0) + diff
            stats["last_attempt"] = now_str
            save_stats(stats)

            # Anti-spam cooldown (at most once per 2 minutes)
            if time.time() - last_alert_time > 120:
                last_alert_time = time.time()
                broadcast_parents(token, config, lambda l: t(l, "alert_attempt", diff=diff, ts=now_str))
        else:
            last_packet_count = current_count


def handle_update(token, update, config):
    message = update.get("message")
    if not message:
        return

    chat_id = message.get("chat", {}).get("id")
    user = message.get("from", {})
    user_id = user.get("id")
    text = (message.get("text") or "").strip()

    parents = [int(p) for p in config.get("parents", [])]

    # Authorization Check
    if user_id not in parents:
        denied_msg = t("uk", "denied", user_id=user_id)
        send_message(token, chat_id, denied_msg)
        return

    current_lang = get_user_lang(user_id, config)

    # 1. If language is not selected yet, or user picked a language option
    if text == "🇺🇦 Українська":
        set_user_lang(user_id, "uk", config)
        send_message(token, chat_id, t("uk", "lang_selected"), get_main_keyboard("uk"))
        send_message(token, chat_id, t("uk", "welcome"), get_main_keyboard("uk"))
        return
    elif text == "🇬🇧 English":
        set_user_lang(user_id, "en", config)
        send_message(token, chat_id, t("en", "lang_selected"), get_main_keyboard("en"))
        send_message(token, chat_id, t("en", "welcome"), get_main_keyboard("en"))
        return

    # If user has no language selected yet, force prompt
    if not current_lang:
        send_message(token, chat_id, t("en", "choose_lang"), get_language_keyboard())
        return

    lang = current_lang

    # 2. Main commands dispatching
    if text in ["/start", t(lang, "btn_help"), "/help", "❓ Help", "❓ Довідка"]:
        send_message(token, chat_id, t(lang, "welcome"), get_main_keyboard(lang))

    elif text in [t(lang, "btn_block"), "🔴 Block Roblox", "🔴 Заблокувати Roblox", "/block"]:
        cancel_active_timer()
        success, out = run_rlb_cmd("on")
        if success:
            msg = t(lang, "blocked_ok")
        else:
            msg = t(lang, "blocked_err", err=clean_terminal_output(out[:400]))
        send_message(token, chat_id, msg, get_main_keyboard(lang))

    elif text in [t(lang, "btn_unblock"), "🟢 Unblock Roblox", "🟢 Розблокувати Roblox", "/unblock"]:
        cancel_active_timer()
        success, out = run_rlb_cmd("off", bypass_pin=True)
        if success:
            msg = t(lang, "unblocked_ok")
        else:
            msg = t(lang, "unblocked_err", err=clean_terminal_output(out[:400]))
        send_message(token, chat_id, msg, get_main_keyboard(lang))

    elif text in [t(lang, "btn_allow_30"), "⏱️ Allow for 30m", "⏱️ Дозволити на 30хв", "/allow30"]:
        cancel_active_timer()
        success, out = run_rlb_cmd("off", bypass_pin=True)
        if success:
            schedule_auto_block(token, chat_id, 30, lang)
            msg = t(lang, "timer_30_ok")
        else:
            msg = t(lang, "unblocked_err", err=clean_terminal_output(out[:400]))
        send_message(token, chat_id, msg, get_main_keyboard(lang))

    elif text in [t(lang, "btn_allow_60"), "⏱️ Allow for 1h", "⏱️ Дозволити на 1год", "/allow60"]:
        cancel_active_timer()
        success, out = run_rlb_cmd("off", bypass_pin=True)
        if success:
            schedule_auto_block(token, chat_id, 60, lang)
            msg = t(lang, "timer_60_ok")
        else:
            msg = t(lang, "unblocked_err", err=clean_terminal_output(out[:400]))
        send_message(token, chat_id, msg, get_main_keyboard(lang))

    elif text in [t(lang, "btn_settings"), "⚙️ Settings", "⚙️ Налаштування", "/settings"]:
        send_message(token, chat_id, t(lang, "settings_menu"), get_settings_keyboard(lang))

    elif text in [t(lang, "btn_lang"), "🌐 Change Language", "🌐 Змінити мову"]:
        send_message(token, chat_id, t(lang, "choose_lang"), get_language_keyboard())

    elif text in [t(lang, "btn_back"), "⬅️ Back", "⬅️ Назад"]:
        send_message(token, chat_id, t(lang, "welcome"), get_main_keyboard(lang))

    elif text in [t(lang, "btn_stats"), "📊 Stats & Report", "📊 Статистика та звіт", "/stats", "📊 Status"]:
        success, out = run_rlb_cmd("status")
        stats = load_stats()
        timer_info = t(lang, "timer_none")
        with timer_lock:
            if timer_end_time > time.time():
                remaining = int((timer_end_time - time.time()) / 60)
                timer_info = t(lang, "timer_active", rem=remaining)

        pin_status = t(lang, "pin_active") if has_pin_configured() else t(lang, "pin_disabled")

        msg = (
            f"{t(lang, 'report_title')}\n"
            f"{t(lang, 'report_packets', count=stats.get('attempts', 0))}\n"
            f"{t(lang, 'report_last', last=stats.get('last_attempt', 'None'))}\n"
            f"{t(lang, 'report_pin', pin=pin_status)}\n"
            f"{t(lang, 'report_timer', timer=timer_info)}\n\n"
            f"{t(lang, 'report_diag', diag=clean_terminal_output(out))}"
        )
        send_message(token, chat_id, msg, get_main_keyboard(lang))

    else:
        send_message(token, chat_id, t(lang, "unknown_cmd"), get_main_keyboard(lang))


def sig_handler(signum, frame):
    global running
    print(f"\n[*] Received signal {signum}, stopping bot daemon...")
    running = False


def main():
    global running
    signal.signal(signal.SIGINT, sig_handler)
    signal.signal(signal.SIGTERM, sig_handler)

    print("[*] Starting RobloxLinuxBlocker Telegram Bot Daemon (Multilingual)...")
    config = load_config()
    token = config.get("bot_token", "").strip()

    if not token:
        print("[!] Error: bot_token is not configured.", file=sys.stderr)
        print("[!] Run: sudo rlb add token <YOUR_BOT_TOKEN>", file=sys.stderr)
        sys.exit(1)

    me = tg_api_request(token, "getMe")
    if not me or not me.get("ok"):
        print("[!] Error: Invalid bot token or cannot connect to Telegram API.", file=sys.stderr)
        sys.exit(1)

    bot_username = me.get("result", {}).get("username", "UnknownBot")
    print(f"[OK] Connected as @{bot_username}")
    print(f"[*] Registered parents: {config.get('parents', [])}")

    # Launch background intrusion detector
    monitor_thread = threading.Thread(target=monitor_connection_attempts, args=(token, config), daemon=True)
    monitor_thread.start()

    offset = 0
    last_config_check = time.time()

    while running:
        if time.time() - last_config_check > 10:
            config = load_config()
            last_config_check = time.time()

        try:
            updates = tg_api_request(token, "getUpdates", {"offset": offset, "timeout": 20})
            if updates and updates.get("ok"):
                for u in updates.get("result", []):
                    offset = u.get("update_id", 0) + 1
                    handle_update(token, u, config)
            else:
                time.sleep(2)
        except Exception as e:
            print(f"[!] Polling error: {e}", file=sys.stderr)
            time.sleep(3)

    print("[*] Telegram Bot Daemon stopped.")


if __name__ == "__main__":
    main()
